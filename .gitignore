# =====================================================
# IDE and Editor Specific Files
# =====================================================

# Visual Studio 2015 user-specific files
.vs/

# Xcode project/workspace files (can be re-generated by Unreal)
*.xcodeproj
*.xcworkspace

# Visual Studio solution and database files (auto-generated by Unreal)
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# RStudio project files (if any R scripts are used for data analysis)
.Rproj.user


# =====================================================
# Compiled Object and Library Files
# =====================================================

# Object files
*.slo
*.lo
*.o
*.obj

# Precompiled headers
*.gch
*.pch

# Static libraries
*.lai
*.la
*.a
*.lib

# Dynamic libraries
*.so
*.so.*
*.dylib
*.dll


# Executables and application bundles
*.exe
*.out
*.app
*.ipa

# Fortran module files (if using any Fortran-based numerical tools)
*.mod


# =====================================================
# Precompiled Asset Images
# =====================================================

# Large binary assets not meant for version control
SourceArt/**/*.png
SourceArt/**/*.tga


# =====================================================
# Unreal Engine Build Artifacts
# =====================================================

# Binaries directories for each ProjectMobius version
UnrealFolder/ProjectMobius/Binaries/*
UnrealFolder/ProjectMobius 5.4/Binaries/*
UnrealFolder/ProjectMobius 5.5/Binaries/*

# Plugin binaries (auto-generated by Unreal)
UnrealFolder/ProjectMobius/Plugins/*/Binaries/*
UnrealFolder/ProjectMobius 5.4/Plugins/*/Binaries/*
UnrealFolder/ProjectMobius 5.5/Plugins/*/Binaries/*

# Build folders
UnrealFolder/Build/*
UnrealFolder/ProjectMobius/Build/**
UnrealFolder/ProjectMobius 5.4/Build/**
UnrealFolder/ProjectMobius 5.5/Build/**

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Preserve icon files in Build folders
!Build/**/*.ico

# Built data for maps (generated by Unreal’s build tools)
*_BuiltData.uasset


# =====================================================
# Unreal Editor–Generated Files
# =====================================================

# Saved directory (logs, autosaves, crash dumps, cooked data)
UnrealFolder/ProjectMobius/Saved/*
UnrealFolder/ProjectMobius 5.4/Saved/*
UnrealFolder/ProjectMobius 5.5/Saved/*

# Intermediate build files (temporary build artifacts)
UnrealFolder/ProjectMobius/Intermediate/*
UnrealFolder/ProjectMobius/Plugins/*/Intermediate/*
UnrealFolder/ProjectMobius 5.4/Intermediate/*
UnrealFolder/ProjectMobius 5.4/Plugins/*/Intermediate/*
UnrealFolder/ProjectMobius 5.5/Intermediate/*
UnrealFolder/ProjectMobius 5.5/Plugins/*/Intermediate/*

# DerivedDataCache (Unreal's shader and asset cache)
UnrealFolder/ProjectMobius/DerivedDataCache/*
UnrealFolder/ProjectMobius 5.4/DerivedDataCache/*
UnrealFolder/ProjectMobius 5.5/DerivedDataCache/*

# Cooked assets and packaged builds
UnrealFolder/ProjectMobius/Saved/Cooked/*
UnrealFolder/ProjectMobius/Saved/StagedBuilds/*
UnrealFolder/ProjectMobius 5.4/Saved/Cooked/*
UnrealFolder/ProjectMobius 5.4/Saved/StagedBuilds/*
UnrealFolder/ProjectMobius 5.5/Saved/Cooked/*
UnrealFolder/ProjectMobius 5.5/Saved/StagedBuilds/*


# =====================================================
# Custom Unreal Content Ignores
# =====================================================

# Ignore large or generated Content subfolders per version
UnrealFolder/ProjectMobius/Content/Crowd/*
UnrealFolder/ProjectMobius/Content/Character/*
UnrealFolder/ProjectMobius/Content/StarterContent/*
UnrealFolder/ProjectMobius/Content/01_Dev/Data/PedestrianMeshes/ImportedUECrowd/Materials/Clothing/Textures/leather/leather-sjqecg1c_Normal_VT.uasset
UnrealFolder/ProjectMobius/Content/Twinmotion/* 
