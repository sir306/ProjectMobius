# Unreal Engine binary assets
*.uasset binary
*.umap binary

# Data files
*.h5 binary
*.hdf5 binary
# 3D model formats
*.fbx binary
*.obj binary
*.gltf text eol=lf
*.glb binary
*.3ds binary
*.blend binary
# Images and textures
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.bmp binary
*.exr binary
*.hdr binary
# Archives
*.zip binary
*.gz binary
*.tar binary
# Documents
*.pdf binary
# Git LFS tracked assets
# Scope LFS rules to versioned asset paths so ignored/generated outputs remain
# outside the LFS policy.
DemoProgressVideos/**/*.mkv filter=lfs diff=lfs merge=lfs -text
docs/images/**/*.gif filter=lfs diff=lfs merge=lfs -text
TestData/**/*.fbx filter=lfs diff=lfs merge=lfs -text
UnrealFolder/ProjectMobius/BuildDocs/*.pdf filter=lfs diff=lfs merge=lfs -text
UnrealFolder/ProjectMobius/Plugins/Hdf5DataPlugin/Hdf5TestData/**/*.h5 filter=lfs diff=lfs merge=lfs -text
UnrealFolder/ProjectMobius/Content/**/*.uasset filter=lfs diff=lfs merge=lfs -text
UnrealFolder/ProjectMobius/Content/**/*.umap filter=lfs diff=lfs merge=lfs -text
# Explicitly keep ignored/generated folders out of LFS tracking.
TestData/LargeTestCases/** -filter -diff -merge
TestData/Technical*/** -filter -diff -merge
UnrealFolder/ProjectMobius/Content/Crowd/** -filter -diff -merge
UnrealFolder/ProjectMobius/Content/Character/** -filter -diff -merge
UnrealFolder/ProjectMobius/Content/Characters/** -filter -diff -merge
UnrealFolder/ProjectMobius/Content/StarterContent/** -filter -diff -merge
UnrealFolder/ProjectMobius/Content/Twinmotion/** -filter -diff -merge
UnrealFolder/ProjectMobius/Content/VRTemplate/** -filter -diff -merge
UnrealFolder/ProjectMobius/Content/VRSpectator/** -filter -diff -merge
UnrealFolder/ProjectMobius/Content/LevelPrototyping/** -filter -diff -merge
UnrealFolder/ProjectMobius/Content/FPWeapon/** -filter -diff -merge
UnrealFolder/ProjectMobius/Content/01_Dev/RuntimeMeshGenerator/DatasmithMasterMaterials/** -filter -diff -merge
UnrealFolder/ProjectMobius/Content/01_Dev/RuntimeMeshGenerator/RuntimeDatasmithOverrides/** -filter -diff -merge
